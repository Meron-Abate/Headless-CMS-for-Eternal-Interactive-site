# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/eternal_cms

# Long random string (e.g. `openssl rand -hex 32`). Never share or commit it.
PAYLOAD_SECRET=change-me

# Public address of this CMS in production, e.g. https://cms.eternalstudio.com (leave empty locally)
PAYLOAD_PUBLIC_SERVER_URL=

# Extra browser origins allowed to call the API (comma-separated), e.g. your website domains
ALLOWED_ORIGINS=

# Rebuild the static website when published content changes.
# The command runs in SITE_REBUILD_CWD (the website folder). Leave empty to disable.
SITE_REBUILD_COMMAND=node scripts/build-from-cms.mjs
SITE_REBUILD_CWD=../Interative-Website-for-Event-Company
# Where the build script reads content from, and the site's public address
CMS_URL=http://localhost:3000
SITE_URL=https://eternalstudio.com
# Or POST to a deploy hook instead of running a command:
# SITE_REBUILD_WEBHOOK_URL=
# SITE_REBUILD_SECRET=
